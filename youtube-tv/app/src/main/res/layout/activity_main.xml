<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0B0D" android:padding="36dp">
<TextView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tihulu YouTube TV" android:textColor="#fff" android:textSize="28sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
<Button android:id="@+id/searchButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/logo" android:layout_marginTop="24dp"/>
<Button android:id="@+id/liveButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live" app:layout_constraintStart_toEndOf="@id/searchButton" app:layout_constraintTop_toTopOf="@id/searchButton" android:layout_marginStart="12dp"/>
<Button android:id="@+id/musicButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music" app:layout_constraintStart_toEndOf="@id/liveButton" app:layout_constraintTop_toTopOf="@id/searchButton" android:layout_marginStart="12dp"/>
<Button android:id="@+id/gamingButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gaming" app:layout_constraintStart_toEndOf="@id/musicButton" app:layout_constraintTop_toTopOf="@id/searchButton" android:layout_marginStart="12dp"/>
<Button android:id="@+id/podcastsButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Podcasts" app:layout_constraintStart_toEndOf="@id/gamingButton" app:layout_constraintTop_toTopOf="@id/searchButton" android:layout_marginStart="12dp"/>
<TextView android:id="@+id/sectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music" android:textColor="#fff" android:textSize="22sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/searchButton" android:layout_marginTop="34dp"/>
<ProgressBar android:id="@+id/progress" android:layout_width="36dp" android:layout_height="36dp" app:layout_constraintStart_toEndOf="@id/sectionTitle" app:layout_constraintTop_toTopOf="@id/sectionTitle" android:layout_marginStart="16dp"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/videoRow" android:layout_width="0dp" android:layout_height="260dp" android:clipToPadding="false" app:layout_constraintTop_toBottomOf="@id/sectionTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="18dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
