<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0B0D" android:padding="30dp">
<EditText android:id="@+id/query" android:layout_width="0dp" android:layout_height="58dp" android:hint="Search YouTube" android:textColor="#fff" android:textColorHint="#9A9AA0" android:background="@drawable/search_field" android:paddingHorizontal="20dp" android:textSize="20sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/goButton" app:layout_constraintTop_toTopOf="parent"/>
<Button android:id="@+id/goButton" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="58dp" android:text="Search" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/query" android:layout_marginStart="12dp"/>
<TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Type a search" android:textColor="#B5B5BA" android:textSize="16sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/query" android:layout_marginTop="16dp"/>
<ProgressBar android:id="@+id/progress" android:layout_width="28dp" android:layout_height="28dp" android:visibility="gone" app:layout_constraintStart_toEndOf="@id/status" app:layout_constraintTop_toTopOf="@id/status" android:layout_marginStart="14dp"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/results" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/status" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
